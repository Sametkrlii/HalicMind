# Run python -m scripts.setup_env to generate matching credentials.
APPLICATION_NAME=HaliçMind
POSTGRES_PASSWORD=
DATABASE_URL=
# Generate a private key with scripts.setup_env; never use a shared sample key.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_EXPIRE_MINUTES=30
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_TLS_MODE=none
SMTP_FROM=noreply@halicmind.local
# For a real SMTP provider: use starttls (often port 587) or ssl (often 465).
# SMTP_USERNAME=
# SMTP_PASSWORD=
